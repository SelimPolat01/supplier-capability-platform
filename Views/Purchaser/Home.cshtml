@using SupplierCapabilitiesAndManagementSystem.Models

@{
    PrimaryButtonModel viewAllPurchasesButtonModel = new()
    {
        Text = "View All",
        Type = "button",
        OnClick = "location.href='/purchaser/purchases'",
        IconClass = "fa-solid fa-arrow-right",
        CssClass = "view-all-button"
    };

    PrimaryButtonModel viewAllSupplierButtonModel = new()
    {
        Text = "View All",
        Type = "button",
        OnClick = "location.href='/purchaser/all-suppliers'",
        IconClass = "fa-solid fa-arrow-right",
        CssClass = "view-all-button"
    };

    PrimaryButtonModel viewAllMachinesButtonModel = new()
    {
        Text = "View All",
        Type = "button",
        OnClick = "location.href='/purchaser/all-supplier-machines'",
        IconClass = "fa-solid fa-arrow-right",
        CssClass = "view-all-button"
    };
}

<div class="home-container">
    <div class="wrapper-vertical-flex">
                <div class="users-container">
            <h2 class="all-users-text"><i class="fa-solid fa-file-invoice-dollar" style="margin-right: 8px; color: #cbd5e1;"></i> All Purchases</h2>
            <vc:purchaser-all-purchases purchaser-id="@ViewBag.PurchaserId" sort-by="@ViewBag.CurrentPurchaseSort"></vc:purchaser-all-purchases>
            <div class="flex-container-1">
                <partial name="_PrimaryButton" model="viewAllPurchasesButtonModel"></partial>
                </div>
            </div>
        </div>


    <div class="wrapper-vertical-flex">
        <div class="users-container">
            <h2 class="all-users-text"><i class="fa-solid fa-users" style="margin-right: 8px; color: #cbd5e1;"></i> All Suppliers</h2>
            <vc:all-suppliers sort-by="@ViewBag.CurrentSupplierSort"></vc:all-suppliers>
            <div class="flex-container-1">
                <partial name="_PrimaryButton" model="viewAllSupplierButtonModel"></partial>
                </div>
            </div>
        </div>

        <div class="wrapper-vertical-flex">
            <div class="users-container">
                <h2 class="all-users-text"><i class="fa-solid fa-gears" style="margin-right: 8px; color: #cbd5e1;"></i> All Machines</h2>
                <vc:all-suppliers-machines sort-by="@ViewBag.CurrentMachineSort"></vc:all-suppliers-machines>
                <div class="flex-container-1">
                    <partial name="_PrimaryButton" model="viewAllMachinesButtonModel"></partial>
                    </div>
                </div>
            </div>

            @section PrimaryButtonStyles {
                <link rel="stylesheet" href="~/css/PrimaryButtonStyles.css" />
            }
        </div>    