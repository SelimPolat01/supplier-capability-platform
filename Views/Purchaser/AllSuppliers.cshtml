@{
    SearchBarModel searchBarModel = new()
    {
        Name = "SearchString",
        Value = ViewBag.CurrentSearch as string ?? "",
        ButtonType = "submit",
        AspController = "Purchaser",
        AspAction = "AllSuppliers",
        Placeholder = "Search suppliers...."
    };
}

<div class="all-suppliers-container">
    <div class="flex-container-1">
        <h2 class="all-suppliers-text">
            <i class="fa-solid fa-users" style="margin-right: 8px; color: #cbd5e1;"></i> All Suppliers
        </h2>
        <partial name="_SearchBar" model="searchBarModel"></partial>
        </div>
        <vc:all-suppliers-with-pagination  page-number="@ViewBag.CurrentPage" sort-by="@ViewBag.CurrentSort" search-string="@ViewBag.CurrentSearch"></vc:all-suppliers-with-pagination>
    </div>

    @section AllSuppliersStyles {
        <link rel="stylesheet" href="~/css/AllSuppliersStyles.css" />
    }

    @section SearchBarStyles {
        <link rel="stylesheet" href="~/css/SearchBarStyles.css" />
    }