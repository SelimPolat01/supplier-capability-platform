@model PurchasingRegisterPostRequestDTO

@{
    InputModel nameInputModel = new()
    {
        Name = "Name",
        Label = "Name",
        Type = "text",        
        InputCssClass = "input",
        LabelCssClass = "label",
        Value = Model?.Name
    };

    InputModel surnameInputModel = new()
    {
        Name = "Surname",
        Label = "Surname",
        Type = "text",
        InputCssClass = "input",
        LabelCssClass = "label",
        Value = Model?.Surname
    };

    InputModel emailInputModel = new()
    {
        Name = "Email",
        Label = "Email",
        Type = "email",
        InputCssClass = "input",
        LabelCssClass = "label",
        Value = Model?.Email
    };

    InputModel passwordInputModel = new()
    {
        Name = "Password",
        Label = "Password",
        Type = "password",
        InputCssClass = "input",
        LabelCssClass = "label",
    };

    PrimaryButtonModel primaryButtonModel = new()
    {
        Type = "submit",
        Text = "Register",
    };
}

<div class="purchasing-register-container">
     <div class="purchasing-register-text-container">
        <h2 class="purchasing-register-text">Purchasing Register</h2>
     </div>
    <form asp-action="PurchasingRegister" method="post" class="purchasing-register-form">
        <div asp-validation-summary="ModelOnly" style="color: red; margin: 0 0 1rem 0;"></div>
        <partial name="_Input" model="nameInputModel"></partial>
            <partial name="_Input" model="surnameInputModel"></partial>

                <partial name="_Input" model="emailInputModel"></partial>
                    <partial name="_Input" model="passwordInputModel"></partial>


                        <partial name="_PrimaryButton" model="primaryButtonModel"></partial>
                        </form>
                    </div>

                    @section PurchasingRegisterStyles {
                        <link rel="stylesheet" href="~/css/PurchasingRegisterStyles.css" />
                    }

                    @section InputStyles {
                        <link rel="stylesheet" href="~/css/InputStyles.css" />
                    }

                    @section PrimaryButtonStyles {
                        <link rel="stylesheet" href="~/css/PrimaryButtonStyles.css" />
                    }


