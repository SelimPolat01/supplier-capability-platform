@model SupplierRegisterPostRequestDTO

@{
    InputModel nameInputModel = new()
    {
        Name = "Name",
        Label = "Name",
        Type = "text",
        InputCssClass = "input",
        LabelCssClass = "label",
        Value = Model?.Name
    };

    InputModel surnameInputModel = new()
    {
        Name = "Surname",
        Label = "Surname",
        Type = "text",        
        InputCssClass = "input",
        LabelCssClass = "label",
        Value = Model?.Surname
    };

    InputModel emailInputModel = new()
    {
        Name = "Email",
        Label = "Email",
        Type = "email",
        InputCssClass = "input",
        LabelCssClass = "label",
        Value = Model?.Email
    };

    InputModel passwordInputModel = new()
    {
        Name = "Password",
        Label = "Password",
        Type = "password",
        InputCssClass = "input",
        LabelCssClass = "label",
    };

    InputModel companyNameInputModel = new()
    {
        Name = "CompanyName",
        Label = "Company Name",
        Type = "text",
        InputCssClass = "input",
        LabelCssClass = "label",
        Value = Model?.CompanyName
    };

    PrimaryButtonModel primaryButtonModel = new()
    {
        Type = "submit",
        Text = "Register",
    };
}

<div class="supplier-register-container">
     <div class="supplier-register-text-container">
        <h2 class="supplier-register-text">Supplier Register</h2>
     </div>
    <form asp-action="SupplierRegister" method="post" class="supplier-register-form">
        <div asp-validation-summary="ModelOnly" style="color: red; margin: 0 0 1rem 0;"></div>
        <partial name="_Input" model="nameInputModel"></partial>
            <partial name="_Input" model="surnameInputModel"></partial>
                <partial name="_Input" model="companyNameInputModel"></partial>
                    <partial name="_Input" model="emailInputModel"></partial>
                        <partial name="_Input" model="passwordInputModel"></partial>
                            <partial name="_PrimaryButton" model="primaryButtonModel"></partial>
                            </form>
                        </div>

                        @section SupplierRegisterStyles {
                            <link rel="stylesheet" href="~/css/SupplierRegisterStyles.css" />
                        }

                        @section InputStyles {
                            <link rel="stylesheet" href="~/css/InputStyles.css" />
                        }

                        @section PrimaryButtonStyles {
                            <link rel="stylesheet" href="~/css/PrimaryButtonStyles.css" />
                        }

