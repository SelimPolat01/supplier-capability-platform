@model LoginPostRequestDTO

@{
    InputModel emailInputModel = new()
    {
        Name = "Email",
        Label = "Email",
        Type = "email",
        Value = Model?.Email,
        InputCssClass = "input",
        LabelCssClass = "label"
    };

    InputModel passwordInputModel = new()
    {
        Name = "Password",
        Label = "Password",
        Type = "password",       
        InputCssClass = "input",
        LabelCssClass = "label"
    };

    PrimaryButtonModel primaryButtonModel = new()
    {
        Type = "submit",
        Text = "Login"
    };
}

<div class="login-container">
    <div class="login-text-container">
        <h2 class="login-text">Login</h2>
     </div>
    <form asp-action="Login" method="post" class="login-form">
        <div asp-validation-summary="ModelOnly" class="login-error-summary" ></div>
        <partial name="_Input" model="emailInputModel"></partial>
            <partial name="_Input" model="passwordInputModel"></partial>
                <div class="remember-me-container">
                    <input asp-for="RememberMe" type="checkbox" id="remember-me-input" />
                    <label for="remember-me-input" id="remember-me-label">Remember Me</label>
                </div>
                <partial name="_PrimaryButton" model="primaryButtonModel"></partial>
                </form>
            </div>

            @section InputStyles {
                <link rel="stylesheet" href="~/css/InputStyles.css" />
            }

            @section LoginStyles {
                <link rel="stylesheet" href="~/css/LoginStyles.css" />
            }

            @section PrimaryButtonStyles {
                <link rel="stylesheet" href="~/css/PrimaryButtonStyles.css" />
            }