@using System.Security.Claims

@{
    int userId = int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!);
    
    SearchBarModel searchBarModel = new()
    {
        Name = "SearchString",
        Value = ViewBag.CurrentSearch as string ?? "",
        ButtonType = "submit",
        AspController = "Supplier",
        AspAction = "Certificates",
        Placeholder = "Search certificates...."
    };
}

<div class="all-certificates-container">
    <div class="flex-container-1">
        <h2 class="all-certificates-text">
            <i class="fa-solid fa-certificate" style="margin-right: 8px; color: #cbd5e1;"></i> All Certificates
        </h2>            
        <partial name="_SearchBar" model="searchBarModel"></partial>
    </div>
    <vc:all-supplier-certificates-with-details user-id="@userId" page-number="@ViewBag.CurrentPage" sort-by="@ViewBag.CurrentSort" search-string="@ViewBag.CurrentSearch"></vc:all-supplier-certificates-with-details>
</div>

@section SupplierCertificatesStyles {
    <link rel="stylesheet" href="~/css/SupplierCertificatesStyles.css" />
}

@section SearchBarStyles {
    <link rel="stylesheet" href="~/css/SearchBarStyles.css" />
}