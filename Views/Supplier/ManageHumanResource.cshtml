@using System.Security.Claims
@using SupplierCapabilitiesAndManagementSystem.Entities
@using SupplierCapabilitiesAndManagementSystem.Models
@using SupplierCapabilitiesAndManagementSystem.Models.DTO

@{
    string? userIdString = User.FindFirstValue(ClaimTypes.NameIdentifier);
    int.TryParse(userIdString, out int userId);
}

<vc:supplier-human-resources user-id="@userId"></vc:supplier-human-resources>

@section SupplierCertificateMachineHumanPurchaseStyles {
        <link rel="stylesheet" href="~/css/SupplierCertificateMachineHumanPurchaseStyles.css" />
}

@section PrimaryButtonStyles {
        <link rel="stylesheet" href="~/css/PrimaryButtonStyles.css" />
}