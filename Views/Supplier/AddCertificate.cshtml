@model AddCertificatePostRequestDTO

@{
    InputModel nameInputModel = new()
    {
        Type = "text",
        Name = "Name",
        Value = Model.Name,
        Label = "Name",
        InputCssClass = "input",
        Placeholder = "e.g., ISO 9001:2015",
        LabelCssClass = "label"
    };

    InputModel issuedByInputModel = new()
    {
        Type = "text",
        Name = "IssuedBy",
        Value = Model.IssuedBy,
        Label = "Issued By",
        InputCssClass = "input",
        Placeholder = "e.g., TÜV Rheinland, TSE",
        LabelCssClass = "label"
    };

    InputModel issueDateInputModel = new()
    {
        Type = "text",
        Name = "IssueDate",
        Value = Model.IssueDate?.ToString("yyyy-MM-dd"),
        Label = "Issue Date",
        Placeholder = "DD-MM-YYYY",
        InputCssClass = "datepicker-input",
        LabelCssClass = "label"
    };

    InputModel expiryDateInputModel = new()
    {
        Type = "text",
        Name = "ExpiryDate",
        Value = Model.ExpiryDate?.ToString("yyyy-MM-dd") ?? "",
        Label = "Expiry Date",
        Placeholder = "DD-MM-YYYY",
        InputCssClass = "datepicker-input",
        LabelCssClass = "label",
    };

    PrimaryButtonModel primaryButtonModel = new()
    {
        Text = "Add",
        Type = "submit",
        CssClass = "add-certificate-button"
    };
}

<div class="add-certificate-container">
    <div class="add-certificate-wrapper">
        <form asp-action="AddCertificate" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" style="color: #ff4d4d; margin-bottom: 15px; font-weight: bold;"></div>
            <div class="half-input-flex-wrapper">
                <partial name="_Input" model="nameInputModel"></partial>
                    <partial name="_Input" model="issuedByInputModel"></partial>
                    </div>
                    <div class="half-input-flex-wrapper">
                        <partial name="_Input" model="issueDateInputModel"></partial>
                            <partial name="_Input" model="expiryDateInputModel"></partial>
                            </div>
                            <div class="custom-file-upload-container">
                                <div class="custom-file-upload-box" onclick="document.getElementById('real-file-input').click();">
                                    <span id="file-name-display">📁 Click to Upload File</span>
                                    <img id="image-preview" />
                                    <iframe id="file-preview-frame"></iframe>
                                </div>
                                <input type="file" id="real-file-input" asp-for="CertificateFile" onchange="fileChangeHandler(this)" accept=".pdf, image/jpg, image/jpeg, image/png" />
                            </div>
                            <span asp-validation-for="CertificateFile" style="color: #ff4d4d; font-size: 0.875rem; margin: 0.2rem 0 1rem 0; display: block;"></span>
                            <partial name="_PrimaryButton" model="primaryButtonModel"></partial>
                            </form>
                        </div>
                    </div>

                    @section AddCertificateStyles {
                        <link rel="stylesheet" href="~/css/AddCertificateStyles.css" />
                    }

                    @section InputStyles {
                        <link rel="stylesheet" href="~/css/InputStyles.css" />

                    }

                    @section PrimaryButtonStyles{
                        <link rel="stylesheet" href="~/css/PrimaryButtonStyles.css" />
                    }

                    @section Scripts {
                        <partial name="_ValidationScriptsPartial"></partial>

                            <script>
                                function fileChangeHandler(input) {
                                    const fileNameDisplay = document.getElementById("file-name-display");
                                    const imgPreview = document.getElementById("image-preview");
                                    const pdfPreview = document.getElementById("file-preview-frame");

                                    if (input.files && input.files.length > 0) {
                                        const file = input.files[0];
                                        const fileUrl = URL.createObjectURL(file);

                                        fileNameDisplay.innerText = "🔄 Click to Change: " + file.name;
                                        fileNameDisplay.style.color = "cyan";

                                        imgPreview.src = "";
                                        pdfPreview.src = "";

                                        if (file.type.startsWith("image/")) {
                                            imgPreview.style.display = "block";
                                            imgPreview.src = fileUrl;
                                        } else if (file.type === "application/pdf") {
                                            pdfPreview.style.display = "block";
                                            pdfPreview.src = fileUrl + "#toolbar=0&navpanes=0&view=FitH";
                                        }
                                    }
                                }

                                                                                                flatpickr(".datepicker-input", {
                                                                                                        dateFormat: "Y-m-d",
                                                                                                        altInput: true,
                                                                                                        altFormat: "d-m-Y",
                                                                                                        allowInput: true
                                                                                                    });
                            </script>
                        }