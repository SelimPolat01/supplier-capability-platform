@model Machine

@{
    PrimaryButtonModel editButtonModel = new()
    {
        Type = "button",
        Text = "Edit",
        OnClick = "toggleEditClickHandler()",
        CssClass = "edit-button"
    };

    PrimaryButtonModel saveButtonModel = new()
    {
        Type = "submit",
        Text = "Save",
        CssClass = "save-button"
    };

    PrimaryButtonModel deleteButtonModel = new()
    {
        Type = "button",
        Text = "Delete",
        OnClick = $"deleteClickHandler()",
        CssClass = "delete-button"
    };

    ConfirmModalModel confirmModalModel = new()
    {
        Title = "Delete Machine",
        Message = "Are you sure you want to delete this machine? This action cannot be undone.",
        OnConfirm = $"confirmDeleteHandler({Model.Id})",
        ConfirmButtonText = "Yes, Delete",
        CancelButtonText = "Cancel",
    };
}

<div class="machine-container">
    <partial name="_ConfirmModal" model="confirmModalModel"></partial>
        <div class="machine-element-wrapper">
            <form onsubmit="submitHandler(event)" id="form">
                <div class="flex-container-1">
                    <h2 class="machine-details-text">Machine Details</h2>
                    <div class="save-edit-button-container">
                        <partial name="_PrimaryButton" model="saveButtonModel"></partial>
                            <partial name="_PrimaryButton" model="editButtonModel"></partial>
                                <partial name="_PrimaryButton" model="deleteButtonModel"></partial>
                                </div>
                            </div>
                            <div class="machine-flex-wrapper">
                                <div class="machine-element-container">
                                    <span class="machine-element-title">Id</span>
                                    <span class="machine-element-id-data">@Model.Id</span>
                                    <input type="hidden" asp-for="Id" />
                                </div>
                                <div class="machine-element-container">
                                    <span class="machine-element-title">Machine Group</span>
                                    <span class="machine-element-data">@Model.MachineGroup</span>
                                    <input type="text" class="editable-input" asp-for="MachineGroup" />
                                </div>
                                <div class="machine-element-container">
                                    <span class="machine-element-title">Machine Type</span>
                                    <span class="machine-element-data">@Model.MachineType</span>
                                    <input type="text" class="editable-input" asp-for="MachineType" />
                                </div>
                                <div class="machine-element-container">
                                    <span class="machine-element-title">Brand / Model</span>
                                    <span class="machine-element-data">@Model.BrandAndModel</span>
                                    <input type="text" class="editable-input" asp-for="BrandAndModel" />
                                </div>
                                <div class="machine-element-container">
                                    <span class="machine-element-title">Production Year</span>
                                    <span class="machine-element-data">@Model.ProductionYear</span>
                                    <input type="number" class="editable-input" asp-for="ProductionYear" />
                                </div>
                                <div class="machine-element-container">
                                    <span class="machine-element-title">Quantity</span>
                                    <span class="machine-element-data">@Model.Quantity</span>
                                    <input type="number" class="editable-input" asp-for="Quantity" />
                                </div>
                                <div class="machine-element-container">
                                    <span class="machine-element-title">AxisCount</span>
                                    <span class="machine-element-data">@Model.AxisCount</span>
                                    <input type="number" class="editable-input" asp-for="AxisCount" />
                                </div>
                                <div class="machine-element-container">
                                    <span class="machine-element-title">Capacity / Specs</span>
                                    <span class="machine-element-data">@Model.CapacitySpecs</span>
                                    <input type="text" class="editable-input" asp-for="CapacitySpecs" />
                                </div>
                                <div class="machine-element-container">
                                    <span class="machine-element-title">Created At</span>
                                    <span class="machine-element-time-data">@Model.CreatedAt</span>
                                </div>
                                <div class="image-file-container">
                                    <h2 class="machine-image-file-text">Image File</h2>
                                    @if (!string.IsNullOrEmpty(Model.ImageUrl) && Model.ImageUrl.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <iframe src="@Model.ImageUrl#toolbar=0&navpanes=0&view=FitH"></iframe>
                                    }
                                    else
                                    {
                                        <img src="@Model.ImageUrl" alt="@Model.BrandAndModel Image" />
                                    }
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                @section MachineStyles {
                    <link rel="stylesheet" href="~/css/MachineStyles.css" />
                }

                @section PrimaryButtonStyles {
                    <link rel="stylesheet" href="~/css/PrimaryButtonStyles.css" />
                }

                @section ConfirmModalStyles{
                    <link rel="stylesheet" href="~/css/ConfirmModalStyles.css" />
                }

                @section Scripts {
                    <script>
                        async function submitHandler(event) {
                            event.preventDefault();

                            const formData = new FormData(event.target);
                            const data = Object.fromEntries(formData.entries());
                            const dataSpans = document.querySelectorAll(".machine-element-data");
                            const editInputs = document.querySelectorAll(".editable-input");
                            const editButton = document.querySelector(".edit-button");
                            const saveButton = document.querySelector(".save-button");

                            dataSpans.forEach(dataSpan => dataSpan.style.display = "");
                            editInputs.forEach(editInput => editInput.style.display = "none");
                            editButton.innerText = "Edit";
                            saveButton.style.display = "none";

                            data.Id = parseInt(data.Id);
                            data.ProductionYear = parseInt(data.ProductionYear);
                            data.Quantity = parseInt(data.Quantity);
                            data.AxisCount = data.AxisCount ? parseInt(data.AxisCount) : null;

                            const machineId = data.Id;

                            try {
                                const response = await fetch(`/supplier/machines/${machineId}/patch`, {
                                    method: "PATCH",
                                    body: JSON.stringify(data),
                                    headers: { "Content-Type": "application/json" },
                                    credentials: "include"
                                });

                                if (!response.ok) {
                                    let errorDetails = "";

                                    try {
                                        const errorData = await response.json();

                                        if (errorData.errors) {
                                            const errorMessages = Object.values(errorData.errors).flat();
                                            errorDetails = errorMessages.join("\n");
                                        }
                                        else if (errorData.message) {
                                            errorDetails = errorData.message;
                                        }
                                        else if (errorData.title) {
                                            errorDetails = errorData.title;
                                        }
                                        else {
                                            errorDetails = JSON.stringify(errorData);
                                        }
                                    } catch (parseError) {
                                        errorDetails = "Server returned a non-JSON error.";
                                    }

                                    throw new Error(`Submit failed (Status: ${response.status})\n\nDetails:\n${errorDetails}`);
                                }

                                window.location.reload();

                            } catch (err) {
                                console.log(err.message);
                                alert(err.message);
                            }
                        }

                        function toggleEditClickHandler() {
                            const dataSpans = document.querySelectorAll(".machine-element-data");
                            const editInputs = document.querySelectorAll(".editable-input");
                            const editButton = document.querySelector(".edit-button");
                            const saveButton = document.querySelector(".save-button");

                            if (editButton.innerText === "Edit") {
                                dataSpans.forEach(dataSpan => dataSpan.style.display = "none");
                                editInputs.forEach(editInput => editInput.style.display = "block");
                                editButton.innerText = "Cancel";
                                if (editInputs.length > 0) editInputs[0].focus();
                                saveButton.style.display = "block";

                            } else if (editButton.innerText === "Cancel") {
                                dataSpans.forEach(dataSpan => dataSpan.style.display = "");
                                editInputs.forEach(editInput => editInput.style.display = "none");
                                editButton.innerText = "Edit";
                                saveButton.style.display = "none";
                            }
                        }

                            function deleteClickHandler() {
                               const confirmModal = document.querySelector(".modal-overlay");

                               confirmModal.style.display = "block";
                            }

                                async function confirmDeleteHandler(machineId) {
                                    try{
                                        const response = await fetch(`/supplier/machines/${machineId}/delete`, {method: "DELETE", credentials: "include"});

                                    if (response.ok) {
                                            window.location.href = '/supplier/machines';
                                    }else {
                                        alert("An error occured while deleting the machine.");
                                        closeModal();
                                    }
                                   }catch(err) {
                                       console.log(err.message);
                                       alert(err.message);
                                       closeModal();
                                   }
                            }

                        function closeModal() {
                                const confirmModal = document.querySelector(".modal-overlay");
                                if (confirmModal) confirmModal.style.display = "none";
                            }
                    </script>
                }