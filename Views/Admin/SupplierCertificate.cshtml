<div class="page-content">
    <vc:supplier-certificate-details user-id="@ViewBag.SupplierId" certificate-id="@ViewBag.CertificateId"></vc:supplier-certificate-details>
</div>

@section SupplierCertificateMachineHumanPurchaseStyles {
    <link rel="stylesheet" href="~/css/SupplierCertificateMachineHumanPurchaseStyles.css" />
}

@section PrimaryButtonStyles {
    <link rel="stylesheet" href="~/css/PrimaryButtonStyles.css" />
}

@section ConfirmModalStyles {
    <link rel="stylesheet" href="~/css/ConfirmModalStyles.css" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        async function submitHandler(event) {
            event.preventDefault();

            if (typeof $!== 'undefined' &&$.validator) {
                if (!$("#form").valid()) {
                    return;
                }
            }

            const formData = new FormData(event.target);
            const data = Object.fromEntries(formData.entries());
            
            const dataSpans = document.querySelectorAll(".item-element-data");
            const editInputs = document.querySelectorAll(".editable-input");
            const editButton = document.querySelector(".edit-button");
            const saveButton = document.querySelector(".save-button");

            dataSpans.forEach(dataSpan => {
                dataSpan.style.removeProperty("display");
            });
            editInputs.forEach(editInput => {
                editInput.style.setProperty("display", "none", "important");
            });
            
            const buttonText = editButton.querySelector("span");
            const buttonIcon = editButton.querySelector("i");
            if (buttonText) buttonText.innerText = "Edit";
            if (buttonIcon) buttonIcon.className = "fa-solid fa-pen-to-square";
            
            saveButton.style.display = "none";

            data.Id = parseInt(data.Id);
            const certificateId = data.Id;
            const supplierId = '@ViewBag.SupplierId'; 
            
            const patchUrl = `/admin/suppliers/${supplierId}/certificates/${certificateId}/patch`;

            try {
                const response = await fetch(patchUrl, {
                    method: "PATCH",
                    body: JSON.stringify(data),
                    headers: { "Content-Type": "application/json" },
                    credentials: "include"
                });

                if (!response.ok) {
                    let errorDetails = "";
                    try {
                        const errorData = await response.json();
                        if (errorData.errors) {
                            const errorMessages = Object.values(errorData.errors).flat();
                            errorDetails = errorMessages.join("\n");
                        } else if (errorData.message) {
                            errorDetails = errorData.message;
                        } else if (errorData.title) {
                            errorDetails = errorData.title;
                        } else {
                            errorDetails = JSON.stringify(errorData);
                        }
                    } catch (parseError) {
                        errorDetails = "Server returned a non-JSON error.";
                    }
                    throw new Error(`Submit failed (Status: ${response.status})\n\nDetails:\n${errorDetails}`);
                }

                window.location.reload();

            } catch (err) {
                console.log(err.message);
                alert(err.message);
            }
        }

        function toggleEditClickHandler() {
            const dataSpans = document.querySelectorAll(".item-element-data");
            const editInputs = document.querySelectorAll(".editable-input");
            const editButton = document.querySelector(".edit-button");
            const saveButton = document.querySelector(".save-button");
            
            const buttonText = editButton.querySelector("span");
            const buttonIcon = editButton.querySelector("i");

            if (buttonText.innerText.trim() === "Edit") {
                dataSpans.forEach(dataSpan => {
                    const parent = dataSpan.parentElement;
                    if (parent && parent.querySelector(".editable-input")) {
                        dataSpan.style.setProperty("display", "none", "important");
                    }
                });
                
                editInputs.forEach(editInput => editInput.style.setProperty("display", "block", "important"));
                
                buttonText.innerText = "Cancel";
                if (buttonIcon) buttonIcon.className = "fa-solid fa-circle-xmark";
                
                if (editInputs.length > 0) editInputs[0].focus();
                saveButton.style.display = "inline-flex";

            } else if (buttonText.innerText.trim() === "Cancel") {
                dataSpans.forEach(dataSpan => dataSpan.style.removeProperty("display"));
                editInputs.forEach(editInput => editInput.style.setProperty("display", "none", "important"));
                
                buttonText.innerText = "Edit";
                if (buttonIcon) buttonIcon.className = "fa-solid fa-pen-to-square";
                
                saveButton.style.display = "none";

                if (typeof $!== 'undefined' &&$.validator) {
                    $("#form").validate().resetForm();
                }
            }
        }

        function deleteClickHandler() {
            const confirmModal = document.querySelector(".modal-overlay");
            if (confirmModal) confirmModal.style.display = "block"; 
        }

        async function confirmDeleteHandler(certificateId) {
            try {
                const supplierId = '@ViewBag.SupplierId'; 
                
                const deleteUrl = `/admin/suppliers/${supplierId}/certificates/${certificateId}/delete`; 

                const response = await fetch(deleteUrl, { 
                    method: "DELETE", 
                    credentials: "include" 
                });

                if (response.ok) {
                    window.location.href = `/admin/suppliers/${supplierId}/certificates`;
                } else {
                    alert("An error occurred while deleting the supplier certificate.");
                    closeModal();
                }
            } catch (err) {
                console.log(err.message);
                alert(err.message);
                closeModal();
            }
        }

        function closeModal() {
            const modals = document.querySelectorAll(".modal-overlay");
            modals.forEach(modal => modal.style.display = "none");
        }

        function toggleScoreDropdown() {
            const scoreDropdownList = document.querySelector("#scoreDropdownList");
            const icon = document.querySelector("#custom-select-icon");

            if (scoreDropdownList.style.display === "block") {
                scoreDropdownList.style.display = "none";
                if(icon) icon.style.transform = "rotate(0deg)";
            } else {
                scoreDropdownList.style.display = "block";
                if(icon) icon.style.transform = "rotate(180deg)";
            }
        }

        function selectScore(value, text, inputId) {
            const selectDisplay = document.querySelector("#select-display");
            const scoreDropdownList = document.querySelector("#scoreDropdownList");
            const scoreInput = document.getElementById(inputId); 
            const scoreButton = document.querySelector(".score-button");
            const icon = document.querySelector("#custom-select-icon");

            if (scoreDropdownList) scoreDropdownList.style.display = "none";
            if (icon) icon.style.transform = "rotate(0deg)";
            
            if (selectDisplay) selectDisplay.innerHTML = text.trim();
            if (scoreInput) scoreInput.value = value;
            if (scoreButton) scoreButton.style.display = "block"; 
        }

        document.addEventListener('click', function(event) {
            const dropdownList = document.getElementById('scoreDropdownList');
            const icon = document.getElementById('custom-select-icon');
            
            if (!event.target.closest('#scoreDropdownWrapper')) {
                if(dropdownList && dropdownList.style.display === 'block') {
                    dropdownList.style.display = 'none';
                    if(icon) icon.style.transform = 'rotate(0deg)';
                }
            }
        });

        function scoreClickHandler() {
            const wrapper = document.getElementById('scoreDropdownWrapper');
            if (!wrapper) return;

            const scoreInput = wrapper.querySelector('input[type="hidden"]');
            const scoreValue = scoreInput ? scoreInput.value : "";

            if (!scoreValue) {
                alert("Please select a score from the dropdown first!");
                return;
            }

            const confirmModal = document.querySelector(".modal-overlay");
            if (confirmModal) confirmModal.style.display = "block"; 
        }

        async function confirmScoreHandler(supplierId, targetId) {
            const wrapper = document.getElementById('scoreDropdownWrapper');
            const scoreInput = wrapper.querySelector('input[type="hidden"]');
            const scoreValue = scoreInput.value;

            try {
                const response = await fetch(`/qualitier/suppliers/${supplierId}/certificates/${targetId}?qualityScore=${scoreValue}`, {
                    method: "PATCH",
                    credentials: "include"
                });

                if (!response.ok) {
                    const errorMessage = await response.json();
                    throw new Error(`An error occurred while submitting the score: ${errorMessage.message || 'Unknown Error'}`);
                }

                alert("Score successfully submitted!");
                window.location.reload(); 

            } catch(err) {
                console.log(err.message);
                alert(err.message);
                closeModal();
            }
        }
    </script>
}