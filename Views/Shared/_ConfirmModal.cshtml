@model ConfirmModalModel

@{
    PrimaryButtonModel confirmButtonModel = new()
    {
        Text = Model?.ConfirmButtonText,
        Type = "button",
        OnClick = Model.OnConfirm,
        CssClass = "confirm-button",
        IconClass = Model?.ConfirmButtonIcon
    };

    PrimaryButtonModel cancelButtonModel = new()
    {
        Text = Model?.CancelButtonText,
        Type = "button",
        OnClick = Model?.OnCancel ?? "closeModal()",
        CssClass = "cancel-button",
        IconClass = Model?.CancelButtonIcon
    };
}

<div class="modal-overlay" style="display: none;">  
    <div class="modal-container @Model?.CssClass">
        <h2 class="modal-title">@Model.Title</h2>
        <p class="modal-message">@Model.Message</p>
        <div class="modal-button-flex-container">
                <partial name="_PrimaryButton" model="cancelButtonModel"></partial>            
                <partial name="_PrimaryButton" model="confirmButtonModel"></partial>
                </div>
            </div>
        </div>