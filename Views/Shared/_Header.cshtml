@{
    string homeController = "";

    if (User.IsInRole("Admin")) homeController = "Admin";
    else if (User.IsInRole("Quality")) homeController = "Quality";
    else if (User.IsInRole("Purchasing")) homeController = "Purchasing";
    else if (User.IsInRole("Supplier")) homeController = "Supplier";

    PrimaryButtonModel logOutButtonModel = new()
    {
        Type = "button",
        Text = "LOG OUT",
        OnClick = "logOutClickHandler()",
        CssClass = "log-out-button",
        IconClass = "fa-solid fa-right-from-bracket"    
    };
}

<header class="header">
    <nav class="nav">
        <ul class="nav-list">
            @if (!User.Identity!.IsAuthenticated)
            {
                <li><a asp-controller="Auth" asp-action="AdminRegister"><i class="fa-solid fa-user-shield"></i> ADMIN REGISTER</a></li>
                <li><a asp-controller="Auth" asp-action="QualityRegister"><i class="fa-solid fa-clipboard-check"></i> QUALITY REGISTER</a></li>
                <li><a asp-controller="Auth" asp-action="PurchasingRegister"><i class="fa-solid fa-file-invoice-dollar"></i> PURCHASING REGISTER</a></li>
                <li><a asp-controller="Auth" asp-action="SupplierRegister"><i class="fa-solid fa-truck-fast"></i> SUPPLIER REGISTER</a></li>
                <li><a asp-controller="Auth" asp-action="Login"><i class="fa-solid fa-right-to-bracket"></i> LOGIN</a></li>
            }
            else
            {
                <li><a asp-controller="@homeController" asp-action="Home"><i class="fa-solid fa-house"></i> HOME</a></li>

                @if (User.IsInRole("Supplier"))
                {
                    <li><a asp-controller="Supplier" asp-action="Machines"><i class="fa-solid fa-gears"></i> MACHINES</a></li>
                    <li><a asp-controller="Supplier" asp-action="Certificates"><i class="fa-solid fa-certificate"></i> CERTIFICATES</a></li>
                }

                <li><partial name="_PrimaryButton" model="logOutButtonModel"></partial></li>
            }
        </ul>
    </nav>
</header>