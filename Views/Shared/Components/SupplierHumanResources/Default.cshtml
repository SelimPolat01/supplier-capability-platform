@model FetchSupplierHumanResourceGetResponseDTO

@{
    bool isAdmin = User.IsInRole("Admin");
    bool isQualitier = User.IsInRole("Qualitier");
    bool isPurchaser = User.IsInRole("Purchaser");
    bool isSupplier = User.IsInRole("Supplier");

    var supplierId = Context.GetRouteValue("supplierId");

    string patchUrl = isAdmin 
        ? $"/admin/edit-human-resource/patch?supplierId={supplierId}" 
        : "/supplier/edit-human-resource/patch";

    PrimaryButtonModel editButtonModel = new()
    {
        Type = "button",
        Text = "Edit",
        OnClick = "toggleEditClickHandler()",
        CssClass = "edit-button",
        IconClass = "fa-solid fa-pen-to-square"
    };

    PrimaryButtonModel saveButtonModel = new()
    {
        Type = "submit",
        Text = "Save",
        CssClass = "save-button",
        IconClass = "fa-solid fa-circle-check"
    };

    PrimaryButtonModel scoreButtonModel = new() 
    { 
        Type = "button", 
        Text = "Submit Score", 
        OnClick = "scoreClickHandler()", 
        CssClass = "score-button", 
        IconClass = "fa-solid fa-ranking-star" 
    };

    ConfirmModalModel confirmModalModel = new()
    {
        Title = "Rate Supplier Human Resources",
        Message = "Are you sure you want to submit score for this human resources record?",
        OnConfirm = $"confirmScoreHandler({Model?.HumanResource?.Id ?? 0})",
        ConfirmButtonText = "Yes, Submit Score",
        ConfirmButtonIcon = "fa-solid fa-check",
        CancelButtonText = "Cancel",
        CancelButtonIcon = "fa-solid fa-circle-xmark"
    };
}

@if (Model != null && Model.IsSuccess && Model.HumanResource != null)
{
    <div class="item-container">
        <partial name="_ConfirmModal" model="confirmModalModel"></partial>
        <div class="item-element-wrapper">
            <form onsubmit="submitHandler(event)" id="form">
                
                @if (!isPurchaser && !isQualitier)
                {
                    <input type="hidden" name="Id" value="@Model.HumanResource.Id" />
                }

                <div class="flex-container-1">
                    <div style="display: flex;">
                        <h2 class="item-details-text">
                            <i class="fa-solid fa-users" style="margin-right: 8px; color: #cbd5e1;"></i>Supplier Human Resources 
                            <span style="display: inline-flex; align-items: center; color: rgba(255, 255, 255, 0.4); font-size: 24px; margin: 0;">
                                #@Model.HumanResource.Id
                            </span>
                        </h2>
                    </div>
                    
                    @if (!isPurchaser && !isQualitier)
                    {
                        <div class="save-edit-button-container">
                            <partial name="_PrimaryButton" model="saveButtonModel"></partial>
                            <partial name="_PrimaryButton" model="editButtonModel"></partial>
                        </div>
                    }
                    else if (isQualitier)
                    {
                        <div>
                            <div class="score-section-container">
                                <partial name="_QualityScoreDropdown" model='new QualityScoreDropdownModel { CurrentScore = Model.HumanResource.QualityScore, InputId = "hrScoreInput", InputName = "QualityScore" }' />
                                <div class="score-button-container">
                                    <partial name="_PrimaryButton" model="scoreButtonModel"></partial>
                                </div>
                                <span id="score-error-message" class="text-danger" style="display: none; margin-top: 0.5rem; font-weight: 500;"></span>
                            </div>
                        </div>
                    }
                </div>
                
                <div class="item-flex-wrapper">                
                    <div class="item-element-container">
                        <span class="item-element-title">Quality Score</span>
                        <span class="item-element-data">
                            @switch (Model.HumanResource.QualityScore)
                            {
                                case QualityScore.A:
                                    <span class="score-a">A</span> <text>Excellent</text>
                                    break;
                                case QualityScore.B:
                                    <span class="score-b">B</span> <text>Good</text>
                                    break;
                                case QualityScore.C:
                                    <span class="score-c">C</span> <text>Average</text>
                                    break;
                                case QualityScore.D:
                                    <span class="score-d">D</span> <text>Poor</text>
                                    break;
                                case QualityScore.F:
                                    <span class="score-f">F</span> <text>Fail</text>
                                    break;
                                default:
                                    <text>Not Rated Yet</text>
                                    break;
                            }
                        </span>
                    </div>

                    <div class="item-element-container">
                        <span class="item-element-title">Total Employee Count</span>
                        <span class="item-element-data">@(Model.HumanResource.TotalEmployeeCount?.ToString() ?? "-")</span>
                        @if (!isPurchaser && !isQualitier) 
                        { 
                            <input type="number" class="editable-input" name="TotalEmployeeCount" value="@Model.HumanResource.TotalEmployeeCount" /> 
                        }
                    </div>
                    
                    <div class="item-element-container">
                        <span class="item-element-title">White Collar Count</span>
                        <span class="item-element-data">@(Model.HumanResource.WhiteCollarCount?.ToString() ?? "-")</span>
                        @if (!isPurchaser && !isQualitier) 
                        { 
                            <input type="number" class="editable-input" name="WhiteCollarCount" value="@Model.HumanResource.WhiteCollarCount" /> 
                        }
                    </div>
                    
                    <div class="item-element-container">
                        <span class="item-element-title">Blue Collar Count</span>
                        <span class="item-element-data">@(Model.HumanResource.BlueCollarCount?.ToString() ?? "-")</span>
                        @if (!isPurchaser && !isQualitier) 
                        { 
                            <input type="number" class="editable-input" name="BlueCollarCount" value="@Model.HumanResource.BlueCollarCount" /> 
                        }
                    </div>
                    
                    <div class="item-element-container">
                        <span class="item-element-title">Engineer Count</span>
                        <span class="item-element-data">@(Model.HumanResource.EngineerCount?.ToString() ?? "-")</span>
                        @if (!isPurchaser && !isQualitier) 
                        { 
                            <input type="number" class="editable-input" name="EngineerCount" value="@Model.HumanResource.EngineerCount" /> 
                        }
                    </div>
                    
                    <div class="item-element-container">
                        <span class="item-element-title">Quality Control Staff Count</span>
                        <span class="item-element-data">@(Model.HumanResource.QualityControlStaffCount?.ToString() ?? "-")</span>
                        @if (!isPurchaser && !isQualitier) 
                        { 
                            <input type="number" class="editable-input" name="QualityControlStaffCount" value="@Model.HumanResource.QualityControlStaffCount" /> 
                        }
                    </div>
                    
                    <div class="item-element-container">
                        <span class="item-element-title">Rnd Staff Count</span>
                        <span class="item-element-data">@(Model.HumanResource.RndStaffCount?.ToString() ?? "-")</span>
                        @if (!isPurchaser && !isQualitier) 
                        { 
                            <input type="number" class="editable-input" name="RndStaffCount" value="@Model.HumanResource.RndStaffCount" /> 
                        }
                    </div>
                    
                    <div class="item-element-container">
                        <span class="item-element-title">Certified Operator Count</span>
                        <span class="item-element-data">@(Model.HumanResource.CertifiedOperatorCount?.ToString() ?? "-")</span>
                        @if (!isPurchaser && !isQualitier) 
                        { 
                            <input type="number" class="editable-input" name="CertifiedOperatorCount" value="@Model.HumanResource.CertifiedOperatorCount" /> 
                        }
                    </div>
                    
                    <div class="item-element-container">
                        <span class="item-element-title">Shift Count</span>
                        <span class="item-element-data">@(Model.HumanResource.ShiftCount?.ToString() ?? "-")</span>
                        @if (!isPurchaser && !isQualitier) 
                        { 
                            <input type="number" class="editable-input" name="ShiftCount" value="@Model.HumanResource.ShiftCount" /> 
                        }
                    </div>
                    
                    <div class="item-element-container">
                        <span class="item-element-title">Working Days Per Week</span>
                        <span class="item-element-data">@(Model.HumanResource.WorkingDaysPerWeek?.ToString() ?? "-")</span>
                        @if (!isPurchaser && !isQualitier) 
                        { 
                            <input type="number" class="editable-input" name="WorkingDaysPerWeek" value="@Model.HumanResource.WorkingDaysPerWeek" /> 
                        }
                    </div>
                    
                    <div class="item-element-container">
                        <span class="item-element-title">Has Labor Union</span>
                        <span class="item-element-data">@(Model.HumanResource.HasLaborUnion == true ? "Yes" : (Model.HumanResource.HasLaborUnion == false ? "No" : "-"))</span>
                        @if (!isPurchaser && !isQualitier) 
                        { 
                            <input type="checkbox" class="editable-input" name="HasLaborUnion" value="true" @(Model.HumanResource.HasLaborUnion == true ? "checked" : "") /> 
                        }
                    </div>
                    
                    <div class="item-element-container">
                        <span class="item-element-title">Employee Turnover Rate</span>
                        <span class="item-element-data">@(Model.HumanResource.EmployeeTurnoverRate?.ToString() ?? "-")</span>
                        @if (!isPurchaser && !isQualitier)
                        {
                            <input type="number" step="any" class="editable-input" name="EmployeeTurnoverRate" value="@(Model.HumanResource.EmployeeTurnoverRate?.ToString(System.Globalization.CultureInfo.InvariantCulture))" />                
                        }
                    </div>

                    <div class="item-element-container">
                        <span class="item-element-title">Last Score Update</span>
                        <span class="item-element-time-data">
                            @(Model.HumanResource.LastScoreUpdate.HasValue 
                                ? Model.HumanResource.LastScoreUpdate.Value.ToString("dd-MM-yyyy HH:mm") 
                                : "Not Rated Yet")
                        </span>
                    </div>

                    <div class="item-element-container">
                        <span class="item-element-title">Qualitier Full Name</span>
                        <span class="item-element-data">
                            @(string.IsNullOrWhiteSpace(Model.HumanResource.QualitierFullName) 
                                ? "Not Rated Yet" 
                                : Model.HumanResource.QualitierFullName)
                        </span>
                    </div>

                    <div class="item-element-container">
                        <span class="item-element-title">Last Updated</span>
                        <span class="item-element-data">@Model.HumanResource.LastUpdatedDate.ToString("dd-MM-yyyy HH:mm")</span>
                    </div>
                </div>
            </form>
        </div>
    </div>
}
else
{
    <div class="alert alert-danger" style="color: white; padding: 20px;">
        <h3>Supplier Human Resources Not Found</h3>
        <p>@(Model?.Message ?? "Data could not be loaded.")</p>
    </div>
}