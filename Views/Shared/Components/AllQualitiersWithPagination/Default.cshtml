@model FetchAllQualitiersGetResponseDTO

<div class="qualitier-list-container">
    <table class="qualitier-table">
        <thead>
            <tr>
                <th><a asp-action="AllQualitiers" asp-controller="Admin" asp-route-sortBy="@(ViewBag.CurrentSort == "id_asc" ? "id_desc" : "id_asc")">Id @(ViewBag.CurrentqualitierSort == "id_asc" ? "↑" : ViewBag.CurrentqualitierSort == "id_desc" ? "↓" : "")</a></th>
                <th><a asp-action="AllQualitiers" asp-controller="Admin" asp-route-sortBy="@(ViewBag.CurrentSort == "name_asc" ? "name_desc" : "name_asc")">Name @(ViewBag.CurrentqualitierSort == "name_asc" ? "↑" : ViewBag.CurrentqualitierSort == "name_desc" ? "↓" : "")</a></th>
                <th><a asp-action="AllQualitiers" asp-controller="Admin" asp-route-sortBy="@(ViewBag.CurrentSort == "surname_asc" ? "surname_desc" : "surname_asc")">Surname @(ViewBag.CurrentqualitierSort == "surname_asc" ? "↑" : ViewBag.CurrentqualitierSort == "surname_desc" ? "↓" : "")</a></th>
                <th><a asp-action="AllQualitiers" asp-controller="Admin" asp-route-sortBy="@(ViewBag.CurrentSort == "email_asc" ? "email_desc" : "email_asc")">Email @(ViewBag.CurrentqualitierSort == "email_asc" ? "↑" : ViewBag.CurrentqualitierSort == "email_desc" ? "↓" : "")</a></th>
                <th><a asp-action="AllQualitiers" asp-controller="Admin" asp-route-sortBy="@(ViewBag.CurrentSort == "added_asc" ? "added_desc" : "added_asc")">Created At @(ViewBag.CurrentqualitierSort == "added_asc" ? "↑" : ViewBag.CurrentqualitierSort == "added_desc" ? "↓" : "")</a></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Data != null && Model.Data.Any())
            {
                foreach (var qualitier in Model.Data)
                {
                    <tr onclick="window.location.href = '/admin/qualitiers/@qualitier.Id'">
                        <td>@qualitier.Id</td>
                        <td>@qualitier.Name</td>
                        <td style="text-transform: uppercase;">@qualitier.Surname</td>
                        <td>@qualitier.Email</td>
                        <td>@qualitier.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9">
                        <div class="empty-state-message">
                            <p>No qualitiers are registered in the system yet.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.TotalPages > 0)
    {
        <div class="pagination-container">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <a asp-action="AllQualitiers" asp-controller="Admin" asp-route-page="@i" asp-route-sortBy="@ViewBag.CurrentSort" asp-route-searchString="@ViewBag.CurrentSearch" class="pagination-button @(Model.CurrentPage == i ? "active-page" : "")">
                    @i
                </a>
            }
        </div>
    }
</div>