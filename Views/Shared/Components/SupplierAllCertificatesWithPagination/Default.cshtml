@model FetchSupplierAllCertificatesGetResponseDTO

@{
    bool isAdmin = User.IsInRole("Admin");
    bool isQualitier = User.IsInRole("Qualitier");
    bool isPurchaser = User.IsInRole("Purchaser");
    bool isSupplier = User.IsInRole("Supplier");

    string targetController = isAdmin ? "Admin" :
                              isQualitier ? "Qualitier" :
                              isPurchaser ? "Purchaser" : 
                              isSupplier ? "Supplier" : "";

    string targetAction = isAdmin ? "SupplierCertificates" :
                          isQualitier ? "SupplierCertificates" :
                          isPurchaser ? "SupplierCertificates" : 
                          isSupplier ? "Certificates" : "";
}

<div class="list-container">
    <table class="table">
        <thead>
            <tr>
                <th><a asp-action="@targetAction" asp-controller="@targetController" asp-route-supplierId="@(isAdmin || isQualitier || isPurchaser ? ViewBag.SupplierId : null)" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-sortBy="@(ViewBag.CurrentSort == "id_asc" ? "id_desc" : "id_asc")">Id @(ViewBag.CurrentSort == "id_asc" ? "↑" : ViewBag.CurrentSort == "id_desc" ? "↓" : "")</a></th>
                <th><a asp-action="@targetAction" asp-controller="@targetController" asp-route-supplierId="@(isAdmin || isQualitier || isPurchaser ? ViewBag.SupplierId : null)" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-sortBy="@(ViewBag.CurrentSort == "name_asc" ? "name_desc" : "name_asc")">Name @(ViewBag.CurrentSort == "name_asc" ? "↑" : ViewBag.CurrentSort == "name_desc" ? "↓" : "")</a></th>
                <th><a asp-action="@targetAction" asp-controller="@targetController" asp-route-supplierId="@(isAdmin || isQualitier || isPurchaser ? ViewBag.SupplierId : null)" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-sortBy="@(ViewBag.CurrentSort == "issued-by_asc" ? "issued-by_desc" : "issued-by_asc")">Issued By @(ViewBag.CurrentSort == "issued-by_asc" ? "↑" : ViewBag.CurrentSort == "issued-by_desc" ? "↓" : "")</a></th>
                <th>
                    <a asp-action="@targetAction" asp-controller="@targetController" asp-route-supplierId="@(isAdmin || isQualitier || isPurchaser ? ViewBag.SupplierId : null)" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-sortBy="@(ViewBag.CurrentSort == "score_asc" ? "score_desc" : "score_asc")">Score @(ViewBag.CurrentSort == "score_asc" ? "↑" : ViewBag.CurrentSort == "score_desc" ? "↓" : "")</a>
                </th>
                <th><a asp-action="@targetAction" asp-controller="@targetController" asp-route-supplierId="@(isAdmin || isQualitier || isPurchaser ? ViewBag.SupplierId : null)" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-sortBy="@(ViewBag.CurrentSort == "issue-date_asc" ? "issue-date_desc" : "issue-date_asc")">Issue Date @(ViewBag.CurrentSort == "issue-date_asc" ? "↑" : ViewBag.CurrentSort == "issue-date_desc" ? "↓" : "")</a></th>
                <th><a asp-action="@targetAction" asp-controller="@targetController" asp-route-supplierId="@(isAdmin || isQualitier || isPurchaser ? ViewBag.SupplierId : null)" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-sortBy="@(ViewBag.CurrentSort == "expiry-date_asc" ? "expiry-date_desc" : "expiry-date_asc")">Expiry Date @(ViewBag.CurrentSort == "expiry-date_asc" ? "↑" : ViewBag.CurrentSort == "expiry-date_desc" ? "↓" : "")</a></th>
                <th>Document</th>
                <th><a asp-action="@targetAction" asp-controller="@targetController" asp-route-supplierId="@(isAdmin || isQualitier || isPurchaser ? ViewBag.SupplierId : null)" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-sortBy="@(ViewBag.CurrentSort == "added_asc" ? "added_desc" : "added_asc")">Date Added @(ViewBag.CurrentSort == "added_asc" ? "↑" : ViewBag.CurrentSort == "added_desc" ? "↓" : "")</a></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Data != null && Model.Data.Any())
            {
                foreach (var certificate in Model.Data)
                {   
                    string rowUrl = "";
                    if (isAdmin) 
                        rowUrl = $"/admin/suppliers/{ViewBag.SupplierId}/certificates/{certificate.Id}";
                    else if (isQualitier)
                        rowUrl = $"/qualitier/suppliers/{ViewBag.SupplierId}/certificates/{certificate.Id}";
                    else if (isPurchaser) 
                        rowUrl = $"/purchaser/suppliers/{ViewBag.SupplierId}/certificates/{certificate.Id}";
                    else if (isSupplier) 
                        rowUrl = $"/supplier/certificates/{certificate.Id}";

                    <tr onclick="window.location.href = '@rowUrl'">
                        <td>@certificate.Id</td>
                        <td>@certificate.Name</td>
                        <td>@certificate.IssuedBy</td>
                            <td>
                            @{
                                string score = certificate.QualityScore?.ToString() ?? "-";
                                string textColor = score switch
                                {
                                    "A" => "color: #4ade80; font-weight: bold;", 
                                    "B" => "color: #60a5fa; font-weight: bold;",
                                    "C" => "color: #fbbf24; font-weight: bold;", 
                                    "D" => "color: #f97316; font-weight: bold;", 
                                    "F" => "color: #ff3552; font-weight: bold;", 
                                    _   => "color: inherit;"                    
                                };
                            }
                            <span style="@textColor">
                                @score
                            </span>
                        </td>         
                        <td>@certificate.IssueDate.ToString("dd-MM-yyyy")</td>
                        <td>@(certificate.ExpiryDate.HasValue ? certificate.ExpiryDate.Value.ToString("dd-MM-yyyy") : "-")</td>
                        <td>
                            <a href="@certificate.DocumentUrl" target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()">View</a>
                        </td>
                        <td>@certificate.CreatedAt.ToString("dd-MM-yyyy HH:mm")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="@(isSupplier ? 7 : 8)">
                        <div class="empty-state-message">
                            <p>No certificates are registered in the system yet.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.TotalPages > 0)
    {
        <div class="pagination-container">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <a asp-action="@targetAction" 
                   asp-controller="@targetController" 
                   asp-route-supplierId="@(isAdmin || isQualitier || isPurchaser ? ViewBag.SupplierId : null)" 
                   asp-route-page="@i" 
                   asp-route-sortBy="@ViewBag.CurrentSort" 
                   asp-route-searchString="@ViewBag.CurrentSearch" 
                   class="pagination-button @(Model.CurrentPage == i ? "active-page" : "")">
                   @i
                </a>
            }
        </div>
    }
</div>