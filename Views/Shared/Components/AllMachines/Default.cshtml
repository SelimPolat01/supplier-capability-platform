@model FetchAllMachinesGetResponseDTO

<div class="machine-list-container">
    @if (Model.Data != null && Model.Data.Any())
    {
        <table class="machine-table">
           <thead>
    <tr>
        <th>
            <a asp-action="Index" asp-controller="Supplier" asp-route-certificateSortBy="@ViewBag.CurrentCertificateSort" asp-route-machineSortBy="@(ViewBag.CurrentMachineSort == "group_asc" ? "group_desc" : "group_asc")">
                Group @(ViewBag.CurrentMachineSort == "group_asc" ? "↑" : ViewBag.CurrentMachineSort == "group_desc" ? "↓" : "")
            </a>
        </th>
        
        <th>
            <a asp-action="Index" asp-controller="Supplier" asp-route-certificateSortBy="@ViewBag.CurrentCertificateSort" asp-route-machineSortBy="@(ViewBag.CurrentMachineSort == "type_asc" ? "type_desc" : "type_asc")">
                Type @(ViewBag.CurrentMachineSort == "type_asc" ? "↑" : ViewBag.CurrentMachineSort == "type_desc" ? "↓" : "")
            </a>
        </th>
        
        <th style="width: 1%; white-space: nowrap;">
            <a asp-action="Index" asp-controller="Supplier" asp-route-certificateSortBy="@ViewBag.CurrentCertificateSort" asp-route-machineSortBy="@(ViewBag.CurrentMachineSort == "brand-model_asc" ? "brand-model_desc" : "brand-model_asc")">
                Brand / Model @(ViewBag.CurrentMachineSort == "brand-model_asc" ? "↑" : ViewBag.CurrentMachineSort == "brand-model_desc" ? "↓" : "")
            </a>
        </th>
        
        <th>File</th>
        
        <th style="width: 1%; white-space: nowrap;">
            <a asp-action="Index" asp-controller="Supplier" asp-route-certificateSortBy="@ViewBag.CurrentCertificateSort" asp-route-machineSortBy="@(ViewBag.CurrentMachineSort == "added_asc" ? "added_desc" : "added_asc")">
                Added @(ViewBag.CurrentMachineSort == "added_asc" ? "↑" : ViewBag.CurrentMachineSort == "added_desc" ? "↓" : "")
            </a>
        </th>
    </tr>
</thead>
            <tbody>
                @foreach (var machine in Model.Data)
                {
                    <tr onclick="window.location.href = '/supplier/machines/@machine.Id'">
                        <td>@machine.MachineGroup</td>
                        <td>@machine.MachineType</td>
                        <td>@machine.BrandAndModel</td>
                        <td>
                            <a href="@machine.ImageUrl" target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()">View</a>
                        </td>
                        <td style="white-space: nowrap;">@machine.CreatedAt.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state-message">
            <p>No machines are registered in the system yet.</p>
        </div>
    }
</div>