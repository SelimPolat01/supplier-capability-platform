@model FetchAllSuppliersMachinesGetResponseDTO

@{
    bool isAdmin = User.IsInRole("Admin");
    bool isPurchaser = User.IsInRole("Purchaser");
    bool isSupplier = User.IsInRole("Supplier");

    string targetController = isAdmin ? "Admin" : 
                              isPurchaser ? "Purchaser" : 
                              isSupplier ? "Supplier" : "";

    string targetAction = isAdmin ? "AllSupplierMachines" : 
                          isPurchaser ? "AllSupplierMachines" : 
                          isSupplier ? "Machines" : "";
}

<div class="machine-list-container">
    <table class="machine-table">
        <thead>
            <tr>
                <th><a asp-action="@targetAction" asp-controller="@targetController" asp-route-supplierId="@(isAdmin || isPurchaser ? ViewBag.SupplierId : null)" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-sortBy="@(ViewBag.CurrentSort == "id_asc" ? "id_desc" : "id_asc")">Id @(ViewBag.CurrentSort == "id_asc" ? "↑" : ViewBag.CurrentSort == "id_desc" ? "↓" : "")</a></th>
                <th><a asp-action="@targetAction" asp-controller="@targetController" asp-route-supplierId="@(isAdmin || isPurchaser ? ViewBag.SupplierId : null)" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-sortBy="@(ViewBag.CurrentSort == "group_asc" ? "group_desc" : "group_asc")">Group @(ViewBag.CurrentSort == "group_asc" ? "↑" : ViewBag.CurrentSort == "group_desc" ? "↓" : "")</a></th>
                <th><a asp-action="@targetAction" asp-controller="@targetController" asp-route-supplierId="@(isAdmin || isPurchaser ? ViewBag.SupplierId : null)" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-sortBy="@(ViewBag.CurrentSort == "type_asc" ? "type_desc" : "type_asc")">Type @(ViewBag.CurrentSort == "type_asc" ? "↑" : ViewBag.CurrentSort == "type_desc" ? "↓" : "")</a></th>
                <th style="width: 1%; white-space: nowrap;"><a asp-action="@targetAction" asp-controller="@targetController" asp-route-supplierId="@(isAdmin || isPurchaser ? ViewBag.SupplierId : null)" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-sortBy="@(ViewBag.CurrentSort == "brand-model_asc" ? "brand-model_desc" : "brand-model_asc")">Brand @(ViewBag.CurrentSort == "brand-model_asc" ? "↑" : ViewBag.CurrentSort == "brand-model_desc" ? "↓" : "")</a></th>
                <th><a asp-action="@targetAction" asp-controller="@targetController" asp-route-supplierId="@(isAdmin || isPurchaser ? ViewBag.SupplierId : null)" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-sortBy="@(ViewBag.CurrentSort == "year_asc" ? "year_desc" : "year_asc")">Year @(ViewBag.CurrentSort == "year_asc" ? "↑" : ViewBag.CurrentSort == "year_desc" ? "↓" : "")</a></th>
                <th><a asp-action="@targetAction" asp-controller="@targetController" asp-route-supplierId="@(isAdmin || isPurchaser ? ViewBag.SupplierId : null)" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-sortBy="@(ViewBag.CurrentSort == "quantity_asc" ? "quantity_desc" : "quantity_asc")">Quantity @(ViewBag.CurrentSort == "quantity_asc" ? "↑" : ViewBag.CurrentSort == "quantity_desc" ? "↓" : "")</a></th>
                <th><a asp-action="@targetAction" asp-controller="@targetController" asp-route-supplierId="@(isAdmin || isPurchaser ? ViewBag.SupplierId : null)" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-sortBy="@(ViewBag.CurrentSort == "axis-count_asc" ? "axis-count_desc" : "axis-count_asc")">Axis Count @(ViewBag.CurrentSort == "axis-count_asc" ? "↑" : ViewBag.CurrentSort == "axis-count_desc" ? "↓" : "")</a></th>
                <th><a asp-action="@targetAction" asp-controller="@targetController" asp-route-supplierId="@(isAdmin || isPurchaser ? ViewBag.SupplierId : null)" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-sortBy="@(ViewBag.CurrentSort == "capacity_asc" ? "capacity_desc" : "capacity_asc")">Capacity @(ViewBag.CurrentSort == "capacity_asc" ? "↑" : ViewBag.CurrentSort == "capacity_desc" ? "↓" : "")</a></th>
                <th><a asp-action="@targetAction" asp-controller="@targetController" asp-route-supplierId="@(isAdmin || isPurchaser ? ViewBag.SupplierId : null)" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-sortBy="@(ViewBag.CurrentSort == "price_asc" ? "price_desc" : "price_asc")">Price @(ViewBag.CurrentSort == "price_asc" ? "↑" : ViewBag.CurrentSort == "price_desc" ? "↓" : "")</a></th>
                <th>File</th>
                <th style="white-space: nowrap;"><a asp-action="@targetAction" asp-controller="@targetController" asp-route-supplierId="@(isAdmin || isPurchaser ? ViewBag.SupplierId : null)" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-sortBy="@(ViewBag.CurrentSort == "added_asc" ? "added_desc" : "added_asc")">Added @(ViewBag.CurrentSort == "added_asc" ? "↑" : ViewBag.CurrentSort == "added_desc" ? "↓" : "")</a></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Data != null && Model.Data.Any())
            {
                foreach (var machine in Model.Data)
                {
                    string rowUrl = "";
                    if (isAdmin) 
                        rowUrl = $"/admin/suppliers/{machine.AppUserId}/machines/{machine.Id}";
                    else if (isPurchaser) 
                        rowUrl = $"/purchaser/suppliers/{machine.AppUserId}/machines/{machine.Id}";
                    else if (isSupplier) 
                        rowUrl = $"/supplier/machines/{machine.Id}";

                    <tr onclick="window.location.href = '@rowUrl'">
                        <td>@machine.Id</td>
                        <td>@machine.MachineGroup</td>
                        <td>@machine.MachineType</td>
                        <td>@machine.BrandAndModel</td>
                        <td>@machine.ProductionYear</td>
                        <td>@machine.Quantity</td>
                        <td>@(machine.AxisCount?.ToString() ?? "-")</td>
                        <td>@machine.CapacitySpecs</td>                        
                        <td style="width: 1%; white-space: nowrap;" class="machine-element-price-data">$@machine.Price.ToString("N0")</td>
                        <td>
                            <a href="@machine.ImageUrl" target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()">View</a>
                        </td>
                        <td>@machine.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="11">
                        <div class="empty-state-message">
                            <p>No machines are registered in the system yet.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.TotalPages > 0)
    {
        <div class="pagination-container">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <a asp-action="@targetAction"
                   asp-controller="@targetController"
                   asp-route-supplierId="@(isAdmin || isPurchaser ? ViewBag.SupplierId : null)"
                   asp-route-page="@i"
                   asp-route-sortBy="@ViewBag.CurrentSort"
                   asp-route-searchString="@ViewBag.CurrentSearch"
                   class="pagination-button @(Model.CurrentPage == i ? "active-page" : "")">
                    @i
                </a>
            }
        </div>
    }
</div>