@model FetchPurchaserAllPurchasesGetResponseDTO

@{
    bool isAdmin = User.IsInRole("Admin");
    bool isQualitier = User.IsInRole("Qualitier");
    bool isPurchaser = User.IsInRole("Purchaser");

    string targetController = isAdmin ? "Admin" : isQualitier ? "Qualitier" : isPurchaser ? "Purchaser" : "";
    string targetAction = isAdmin ? "PurchaserPurchases" : isQualitier ? "PurchaserPurchases" : isPurchaser ? "Purchases" : "";
}

<div class="list-container">
    <table class="table">
        <thead>
            <tr>
                <th>
                    <a asp-action="@targetAction" asp-controller="@targetController" asp-route-purchaserId="@ViewBag.PurchaserId" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-sortBy="@(ViewBag.CurrentSort == "id_asc" ? "id_desc" : "id_asc")">Id @(ViewBag.CurrentSort == "id_asc" ? "↑" : ViewBag.CurrentSort == "id_desc" ? "↓" : "")</a>
                </th>
                <th>
                    <a asp-action="@targetAction" asp-controller="@targetController" asp-route-purchaserId="@ViewBag.PurchaserId" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-sortBy="@(ViewBag.CurrentSort == "group_asc" ? "group_desc" : "group_asc")">Group @(ViewBag.CurrentSort == "group_asc" ? "↑" : ViewBag.CurrentSort == "group_desc" ? "↓" : "")</a>
                </th>
                <th>
                    <a asp-action="@targetAction" asp-controller="@targetController" asp-route-purchaserId="@ViewBag.PurchaserId" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-sortBy="@(ViewBag.CurrentSort == "type_asc" ? "type_desc" : "type_asc")">Type @(ViewBag.CurrentSort == "type_asc" ? "↑" : ViewBag.CurrentSort == "type_desc" ? "↓" : "")</a>
                </th>
                <th>
                    <a asp-action="@targetAction" asp-controller="@targetController" asp-route-purchaserId="@ViewBag.PurchaserId" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-sortBy="@(ViewBag.CurrentSort == "brand-model_asc" ? "brand-model_desc" : "brand-model_asc")">Brand @(ViewBag.CurrentSort == "brand-model_asc" ? "↑" : ViewBag.CurrentSort == "brand-model_desc" ? "↓" : "")</a>
                </th>
                <th>
                    <a asp-action="@targetAction" asp-controller="@targetController" asp-route-purchaserId="@ViewBag.PurchaserId" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-sortBy="@(ViewBag.CurrentSort == "production-year_asc" ? "production-year_desc" : "production-year_asc")">Prod. Year @(ViewBag.CurrentSort == "production-year_asc" ? "↑" : ViewBag.CurrentSort == "production-year_desc" ? "↓" : "")</a>
                </th>
                <th>
                    <a asp-action="@targetAction" asp-controller="@targetController" asp-route-purchaserId="@ViewBag.PurchaserId" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-sortBy="@(ViewBag.CurrentSort == "quantity_asc" ? "quantity_desc" : "quantity_asc")">Quantity @(ViewBag.CurrentSort == "quantity_asc" ? "↑" : ViewBag.CurrentSort == "quantity_desc" ? "↓" : "")</a>
                </th>
                <th>
                    <a asp-action="@targetAction" asp-controller="@targetController" asp-route-purchaserId="@ViewBag.PurchaserId" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-sortBy="@(ViewBag.CurrentSort == "axis-count_asc" ? "axis-count_desc" : "axis-count_asc")">Axis Count @(ViewBag.CurrentSort == "axis-count_asc" ? "↑" : ViewBag.CurrentSort == "axis-count_desc" ? "↓" : "")</a>
                </th>
                <th>
                    <a asp-action="@targetAction" asp-controller="@targetController" asp-route-purchaserId="@ViewBag.PurchaserId" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-sortBy="@(ViewBag.CurrentSort == "capacity_asc" ? "capacity_desc" : "capacity_asc")">Capacity @(ViewBag.CurrentSort == "capacity_asc" ? "↑" : ViewBag.CurrentSort == "capacity_desc" ? "↓" : "")</a>
                </th>
               <th>
                    <a asp-action="@targetAction" asp-controller="@targetController" asp-route-purchaserId="@ViewBag.PurchaserId" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-sortBy="@(ViewBag.CurrentSort == "supplier-id_asc" ? "supplier-id_desc" : "supplier-id_asc")">Supplier Id @(ViewBag.CurrentSort == "supplier-id_asc" ? "↑" : ViewBag.CurrentSort == "supplier-id_desc" ? "↓" : "")</a>
                </th>
                <th>
                    <a asp-action="@targetAction" asp-controller="@targetController" asp-route-purchaserId="@ViewBag.PurchaserId" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-sortBy="@(ViewBag.CurrentSort == "cost_asc" ? "cost_desc" : "cost_asc")">Total Cost @(ViewBag.CurrentSort == "cost_asc" ? "↑" : ViewBag.CurrentSort == "cost_desc" ? "↓" : "")</a>
                </th>
                <th>
                    <a asp-action="@targetAction" asp-controller="@targetController" asp-route-purchaserId="@ViewBag.PurchaserId" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-sortBy="@(ViewBag.CurrentSort == "cost_asc" ? "cost_desc" : "cost_asc")">Score @(ViewBag.CurrentSort == "score_asc" ? "↑" : ViewBag.CurrentSort == "cost_desc" ? "↓" : "")</a>
                </th>
                <th>Image</th>
                <th>
                    <a asp-action="@targetAction" asp-controller="@targetController" asp-route-purchaserId="@ViewBag.PurchaserId" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-sortBy="@(ViewBag.CurrentSort == "added_asc" ? "added_desc" : "added_asc")">Date Added @(ViewBag.CurrentSort == "added_asc" ? "↑" : ViewBag.CurrentSort == "added_desc" ? "↓" : "")</a>
                </th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Data != null && Model.Data.Any())
            {
                @foreach (var purchase in Model.Data)
                {
                    string rowUrl = isAdmin 
                        ? $"/admin/purchasers/{ViewBag.PurchaserId}/purchases/{purchase.Id}" 
                        : isQualitier ? $"/qualitier/purchasers/{ViewBag.PurchaserId}/purchases/{purchase.Id}" 
                        : isPurchaser ? $"/purchaser/purchases/{purchase.Id}" : "#";

                    <tr onclick="window.location.href = '@rowUrl'">
                        <td>@purchase.Id</td>
                        <td>@purchase.MachineDetails.MachineGroup</td>
                        <td>@purchase.MachineDetails.MachineType</td>
                        <td>@purchase.MachineDetails.BrandAndModel</td>
                        <td>@purchase.MachineDetails.ProductionYear</td>
                        <td>@purchase.Quantity</td>
                        <td>@purchase.MachineDetails.AxisCount</td>
                        <td>@purchase.MachineDetails.CapacitySpecs</td>
                        <td>@purchase.MachineDetails.AppUserId</td>
                        <td class="element-price-data">$@purchase.TotalPurchasedPrice.ToString("N0")</td>
                        <td>
                            @{
                                string score = purchase.QualityScore?.ToString() ?? "-";
                                string textColor = score switch
                                {
                                    "A" => "color: #4ade80; font-weight: bold;", 
                                    "B" => "color: #60a5fa; font-weight: bold;",
                                    "C" => "color: #fbbf24; font-weight: bold;", 
                                    "D" => "color: #f97316; font-weight: bold;", 
                                    "F" => "color: #ff3552; font-weight: bold;", 
                                    _   => "color: inherit;"                    
                                };
                            }
                            <span style="@textColor">
                                @score
                            </span>
                        </td>
                        <td>
                            <a href="@purchase.MachineDetails.ImageUrl" target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()">View</a>
                        </td>
                        <td>@purchase.PurchaseDate.ToString("dd-MM-yyyy HH:mm")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="13">
                        <div class="empty-state-message">
                            <p>No purchases are registered in the system yet.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.TotalPages > 0)
    {
        <div class="pagination-container">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <a asp-action="@targetAction"
                   asp-controller="@targetController"
                   asp-route-purchaserId="@ViewBag.PurchaserId"
                   asp-route-page="@i"
                   asp-route-sortBy="@ViewBag.CurrentSort"
                   asp-route-searchString="@ViewBag.CurrentSearch"
                   class="pagination-button @(Model.CurrentPage == i ? "active-page" : "")">
                    @i
                </a>
            }   
        </div>
    }
</div>