@model FetchAllSuppliersGetResponseDTO

@{
    bool isAdmin = User.IsInRole("Admin");
    bool isPurchaser = User.IsInRole("Purchaser");
    bool isQualitier = User.IsInRole("Qualitier");

    string targetController = isAdmin ? "Admin" : isQualitier ? "Qualitier" : isPurchaser ? "Purchaser" : "";
}

<div id="supplier-section" class="list-container">
    <table class="table">
        <thead>
            <tr>
                <th style="padding: 0.75rem;"><a asp-fragment="supplier-section" asp-action="Home" asp-controller="@targetController" asp-route-qualitierSortBy="@(isAdmin ? ViewBag.CurrentQualitierSort : null)" asp-route-purchaserSortBy="@(isAdmin ? ViewBag.CurrentPurchaserSort : null)" asp-route-machineSortBy="@(isPurchaser ? ViewBag.CurrentMachineSort : null)" asp-route-supplierSortBy="@(ViewBag.CurrentSupplierSort == "id_asc" ? "id_desc" : "id_asc")">Id @(ViewBag.CurrentSupplierSort == "id_asc" ? "↑" : ViewBag.CurrentSupplierSort == "id_desc" ? "↓" : "")</a></th>
                <th style="padding: 0.75rem;"><a asp-fragment="supplier-section" asp-action="Home" asp-controller="@targetController" asp-route-qualitierSortBy="@(isAdmin ? ViewBag.CurrentQualitierSort : null)" asp-route-purchaserSortBy="@(isAdmin ? ViewBag.CurrentPurchaserSort : null)" asp-route-machineSortBy="@(isPurchaser ? ViewBag.CurrentMachineSort : null)" asp-route-supplierSortBy="@(ViewBag.CurrentSupplierSort == "name_asc" ? "name_desc" : "name_asc")">Name @(ViewBag.CurrentSupplierSort == "name_asc" ? "↑" : ViewBag.CurrentSupplierSort == "name_desc" ? "↓" : "")</a></th>
                <th style="padding: 0.75rem;"><a asp-fragment="supplier-section" asp-action="Home" asp-controller="@targetController" asp-route-qualitierSortBy="@(isAdmin ? ViewBag.CurrentQualitierSort : null)" asp-route-purchaserSortBy="@(isAdmin ? ViewBag.CurrentPurchaserSort : null)" asp-route-machineSortBy="@(isPurchaser ? ViewBag.CurrentMachineSort : null)" asp-route-supplierSortBy="@(ViewBag.CurrentSupplierSort == "surname_asc" ? "surname_desc" : "surname_asc")">Surname @(ViewBag.CurrentSupplierSort == "surname_asc" ? "↑" : ViewBag.CurrentSupplierSort == "surname_desc" ? "↓" : "")</a></th>
                <th style="padding: 0.75rem;"><a asp-fragment="supplier-section" asp-action="Home" asp-controller="@targetController" asp-route-qualitierSortBy="@(isAdmin ? ViewBag.CurrentQualitierSort : null)" asp-route-purchaserSortBy="@(isAdmin ? ViewBag.CurrentPurchaserSort : null)" asp-route-machineSortBy="@(isPurchaser ? ViewBag.CurrentMachineSort : null)" asp-route-supplierSortBy="@(ViewBag.CurrentSupplierSort == "company-name_asc" ? "company-name_desc" : "company-name_asc")">Company Name @(ViewBag.CurrentSupplierSort == "company-name_asc" ? "↑" : ViewBag.CurrentSupplierSort == "company-name_desc" ? "↓" : "")</a></th>
                <th style="padding: 0.75rem;"><a asp-fragment="supplier-section" asp-action="Home" asp-controller="@targetController" asp-route-qualitierSortBy="@(isAdmin ? ViewBag.CurrentQualitierSort : null)" asp-route-purchaserSortBy="@(isAdmin ? ViewBag.CurrentPurchaserSort : null)" asp-route-machineSortBy="@(isPurchaser ? ViewBag.CurrentMachineSort : null)" asp-route-supplierSortBy="@(ViewBag.CurrentSupplierSort == "email_asc" ? "email_desc" : "email_asc")">Email @(ViewBag.CurrentSupplierSort == "email_asc" ? "↑" : ViewBag.CurrentSupplierSort == "email_desc" ? "↓" : "")</a></th>
                <th style="padding: 0.75rem;"><a asp-fragment="supplier-section" asp-action="Home" asp-controller="@targetController" asp-route-qualitierSortBy="@(isAdmin ? ViewBag.CurrentQualitierSort : null)" asp-route-purchaserSortBy="@(isAdmin ? ViewBag.CurrentPurchaserSort : null)" asp-route-machineSortBy="@(isPurchaser ? ViewBag.CurrentMachineSort : null)" asp-route-supplierSortBy="@(ViewBag.CurrentSupplierSort == "certificates_asc" ? "certificates_desc" : "certificates_asc")">Certificates @(ViewBag.CurrentSupplierSort == "certificates_asc" ? "↑" : ViewBag.CurrentSupplierSort == "certificates_desc" ? "↓" : "")</a></th>
                <th style="padding: 0.75rem;"><a asp-fragment="supplier-section" asp-action="Home" asp-controller="@targetController" asp-route-qualitierSortBy="@(isAdmin ? ViewBag.CurrentQualitierSort : null)" asp-route-purchaserSortBy="@(isAdmin ? ViewBag.CurrentPurchaserSort : null)" asp-route-machineSortBy="@(isPurchaser ? ViewBag.CurrentMachineSort : null)" asp-route-supplierSortBy="@(ViewBag.CurrentSupplierSort == "machines_asc" ? "machines_desc" : "machines_asc")">Machines @(ViewBag.CurrentSupplierSort == "machines_asc" ? "↑" : ViewBag.CurrentSupplierSort == "machines_desc" ? "↓" : "")</a></th>
                <th style="padding: 0.75rem;"><a asp-fragment="supplier-section" asp-action="Home" asp-controller="@targetController" asp-route-qualitierSortBy="@(isAdmin ? ViewBag.CurrentQualitierSort : null)" asp-route-purchaserSortBy="@(isAdmin ? ViewBag.CurrentPurchaserSort : null)" asp-route-machineSortBy="@(isPurchaser ? ViewBag.CurrentMachineSort : null)" asp-route-supplierSortBy="@(ViewBag.CurrentSupplierSort == "human-resources_asc" ? "human-resources_desc" : "human-resources_asc")">Human Resources @(ViewBag.CurrentSupplierSort == "human-resources_asc" ? "↑" : ViewBag.CurrentSupplierSort == "human-resources_desc" ? "↓" : "")</a></th>
                <th style="padding: 0.75rem;"><a asp-fragment="supplier-section" asp-action="Home" asp-controller="@targetController" asp-route-qualitierSortBy="@(isAdmin ? ViewBag.CurrentQualitierSort : null)" asp-route-purchaserSortBy="@(isAdmin ? ViewBag.CurrentPurchaserSort : null)" asp-route-machineSortBy="@(isPurchaser ? ViewBag.CurrentMachineSort : null)" asp-route-supplierSortBy="@(ViewBag.CurrentSupplierSort == "added_asc" ? "added_desc" : "added_asc")">Added @(ViewBag.CurrentSupplierSort == "added_asc" ? "↑" : ViewBag.CurrentSupplierSort == "added_desc" ? "↓" : "")</a></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Data != null && Model.Data.Any())
            {
                foreach (var supplier in Model.Data)
                {
                    <tr onclick="window.location.href = '/@targetController.ToLower()/suppliers/@supplier.Id'">                        
                        <td style="padding: 0.75rem;">@supplier.Id</td>
                        <td style="padding: 0.75rem;">@supplier.Name</td>
                        <td style="padding: 0.75rem; text-transform: uppercase;">@supplier.Surname</td>
                        <td style="padding: 0.75rem;">@supplier.CompanyName</td>
                        <td style="padding: 0.75rem;">@supplier.Email</td>
                        <td style="padding: 0.75rem;">
                            <a asp-controller="@targetController" asp-action="SupplierCertificates" asp-route-supplierId="@supplier.Id" onclick="event.stopPropagation()" class="resource-link">
                                Certificates <span class="count-badge">@supplier.Certificates.Count</span>
                            </a>
                        </td>
                        <td style="padding: 0.75rem;">
                            <a asp-controller="@targetController" asp-action="SupplierMachines" asp-route-supplierId="@supplier.Id" onclick="event.stopPropagation()" class="resource-link">
                                Machines <span class="count-badge">@supplier.Machines.Count</span>
                            </a>
                        </td>
                        <td style="padding: 0.75rem;">
                            <a asp-controller="@targetController" asp-action="SupplierHumanResources" asp-route-supplierId="@supplier.Id" onclick="event.stopPropagation()" class="resource-link">
                                HR 
                                @if (supplier.HumanResources.Count > 0)
                                {
                                    <i class="fa-solid fa-circle-check" style="color: #2ed47a; margin: 0 0 3px 0;" title="Completed"></i>
                                }
                                else
                                {
                                    <i class="fa-solid fa-circle-minus" style="color: rgba(255, 255, 255, 0.2); margin: 0 0 3px 0;" title="Missing"></i>
                                }
                            </a>
                        </td>
                        <td style="padding: 0.75rem;">@supplier.CreatedAt.ToString("dd-MM-yyyy")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9">
                        <div class="empty-state-message">
                            <p>No suppliers are registered in the system yet.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>