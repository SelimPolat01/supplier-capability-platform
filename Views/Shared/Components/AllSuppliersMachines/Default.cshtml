@model FetchAllSuppliersMachinesGetResponseDTO

@{
    bool isAdmin = User.IsInRole("Admin");
    bool isQualitier = User.IsInRole("Qualitier");
    bool isPurchaser = User.IsInRole("Purchaser");

    string targetController = isAdmin ? "Admin" : isQualitier ? "Qualitier" : isPurchaser ? "Purchaser" : "";
}

<div  id="machines-container" class="list-container">
    <table class="table">
        <thead>
            <tr>
                <th style="width: 1%; white-space: nowrap; padding: 0.75rem;">
                    <a 
                       asp-fragment="machines-container" 
                       asp-action="Home" 
                       asp-controller="@targetController"
                       asp-route-certificateSortBy="@ViewBag.CurrentCertificateSort"
                       asp-route-supplierSortBy="@ViewBag.CurrentSupplierSort" 
                       asp-route-qualitierSortBy="@(isAdmin ? ViewBag.CurrentQualitierSort : null)" 
                       asp-route-purchaserSortBy="@ViewBag.CurrentPurchaserSort" 
                       asp-route-machineSortBy="@(ViewBag.CurrentMachineSort == "id_asc" ? "id_desc" : "id_asc")">
                        Id @(ViewBag.CurrentMachineSort == "id_asc" ? "↑" : ViewBag.CurrentMachineSort == "id_desc" ? "↓" : "")
                    </a>
                </th>
                <th style="width: 1%; white-space: nowrap; padding: 0.75rem;">
                    <a 
                       asp-fragment="machines-container"  
                       asp-action="Home" 
                       asp-controller="@targetController" 
                       asp-route-certificateSortBy="@ViewBag.CurrentCertificateSort"
                       asp-route-supplierSortBy="@ViewBag.CurrentSupplierSort" 
                       asp-route-qualitierSortBy="@(isAdmin ? ViewBag.CurrentQualitierSort : null)" 
                       asp-route-purchaserSortBy="@ViewBag.CurrentPurchaserSort" 
                       asp-route-machineSortBy="@(ViewBag.CurrentMachineSort == "group_asc" ? "group_desc" : "group_asc")">
                        Group @(ViewBag.CurrentMachineSort == "group_asc" ? "↑" : ViewBag.CurrentMachineSort == "group_desc" ? "↓" : "")
                    </a>
                </th>
                <th style="width: 1%; white-space: nowrap; padding: 0.75rem;">
                    <a 
                       asp-fragment="machines-container"  
                       asp-action="Home" 
                       asp-controller="@targetController" 
                       asp-route-certificateSortBy="@ViewBag.CurrentCertificateSort"
                       asp-route-supplierSortBy="@ViewBag.CurrentSupplierSort" 
                       asp-route-qualitierSortBy="@(isAdmin ? ViewBag.CurrentQualitierSort : null)" 
                       asp-route-purchaserSortBy="@ViewBag.CurrentPurchaserSort" 
                       asp-route-machineSortBy="@(ViewBag.CurrentMachineSort == "type_asc" ? "type_desc" : "type_asc")">
                        Type @(ViewBag.CurrentMachineSort == "type_asc" ? "↑" : ViewBag.CurrentMachineSort == "type_desc" ? "↓" : "")
                    </a>
                </th>
                <th style="width: 1%; white-space: nowrap; padding: 0.75rem;">
                    <a 
                       asp-fragment="machines-container"  
                       asp-action="Home" 
                       asp-route-certificateSortBy="@ViewBag.CurrentCertificateSort"
                       asp-route-supplierSortBy="@ViewBag.CurrentSupplierSort" 
                       asp-route-qualitierSortBy="@(isAdmin ? ViewBag.CurrentQualitierSort : null)" 
                       asp-route-purchaserSortBy="@ViewBag.CurrentPurchaserSort" 
                       asp-route-machineSortBy="@(ViewBag.CurrentMachineSort == "brand-model_asc" ? "brand-model_desc" : "brand-model_asc")">
                        Brand @(ViewBag.CurrentMachineSort == "brand-model_asc" ? "↑" : ViewBag.CurrentMachineSort == "brand-model_desc" ? "↓" : "")
                    </a>
                </th>
                <th style="width: 1%; white-space: nowrap; padding: 0.75rem;">
                    <a 
                       asp-fragment="machines-container"  
                       asp-action="Home" 
                       asp-controller="@targetController" 
                       asp-route-certificateSortBy="@ViewBag.CurrentCertificateSort"
                       asp-route-supplierSortBy="@ViewBag.CurrentSupplierSort" 
                       asp-route-qualitierSortBy="@(isAdmin ? ViewBag.CurrentQualitierSort : null)" 
                       asp-route-purchaserSortBy="@ViewBag.CurrentPurchaserSort" 
                       asp-route-machineSortBy="@(ViewBag.CurrentMachineSort == "year_asc" ? "year_desc" : "year_asc")">
                        Year @(ViewBag.CurrentMachineSort == "year_asc" ? "↑" : ViewBag.CurrentMachineSort == "year_desc" ? "↓" : "")
                    </a>
                </th>
                <th style="width: 1%; white-space: nowrap; padding: 0.75rem;">
                    <a 
                       asp-fragment="machines-container"  
                       asp-action="Home" 
                       asp-controller="@targetController" 
                       asp-route-certificateSortBy="@ViewBag.CurrentCertificateSort"
                       asp-route-supplierSortBy="@ViewBag.CurrentSupplierSort" 
                       asp-route-qualitierSortBy="@(isAdmin ? ViewBag.CurrentQualitierSort : null)" 
                       asp-route-purchaserSortBy="@ViewBag.CurrentPurchaserSort" 
                       asp-route-machineSortBy="@(ViewBag.CurrentMachineSort == "quantity_asc" ? "quantity_desc" : "quantity_asc")">
                        Quantity @(ViewBag.CurrentMachineSort == "quantity_asc" ? "↑" : ViewBag.CurrentMachineSort == "quantity_desc" ? "↓" : "")
                    </a>
                </th>
                <th style="width: 1%; white-space: nowrap; padding: 0.75rem;">
                    <a 
                       asp-fragment="machines-container"  
                       asp-action="Home" 
                       asp-controller="@targetController" 
                       asp-route-certificateSortBy="@ViewBag.CurrentCertificateSort"
                       asp-route-supplierSortBy="@ViewBag.CurrentSupplierSort" 
                       asp-route-qualitierSortBy="@(isAdmin ? ViewBag.CurrentQualitierSort : null)" 
                       asp-route-purchaserSortBy="@ViewBag.CurrentPurchaserSort" 
                       asp-route-machineSortBy="@(ViewBag.CurrentMachineSort == "axis-count_asc" ? "axis-count_desc" : "axis-count_asc")">
                        Axis Count @(ViewBag.CurrentMachineSort == "axis-count_asc" ? "↑" : ViewBag.CurrentMachineSort == "axis-count_desc" ? "↓" : "")
                    </a>
                </th>
                <th style="width: 1%; white-space: nowrap; padding: 0.75rem;">
                    <a 
                       asp-fragment="machines-container"  
                       asp-action="Home" 
                       asp-controller="@targetController" 
                       asp-route-certificateSortBy="@ViewBag.CurrentCertificateSort"
                       asp-route-supplierSortBy="@ViewBag.CurrentSupplierSort" 
                       asp-route-qualitierSortBy="@(isAdmin ? ViewBag.CurrentQualitierSort : null)" 
                       asp-route-purchaserSortBy="@ViewBag.CurrentPurchaserSort" 
                       asp-route-machineSortBy="@(ViewBag.CurrentMachineSort == "capacity_asc" ? "capacity_desc" : "capacity_asc")">
                        Capacity @(ViewBag.CurrentMachineSort == "capacity_asc" ? "↑" : ViewBag.CurrentMachineSort == "capacity_desc" ? "↓" : "")
                    </a>
                </th>
                <th style="width: 1%; white-space: nowrap; padding: 0.75rem;">File</th>
                <th style="width: 1%; white-space: nowrap; padding: 0.75rem;">
                    <a 
                       asp-fragment="machines-container"  
                       asp-action="Home" 
                       asp-controller="@targetController" 
                       asp-route-certificateSortBy="@ViewBag.CurrentCertificateSort"
                       asp-route-supplierSortBy="@ViewBag.CurrentSupplierSort" 
                       asp-route-qualitierSortBy="@(isAdmin ? ViewBag.CurrentQualitierSort : null)" 
                       asp-route-purchaserSortBy="@ViewBag.CurrentPurchaserSort" 
                       asp-route-machineSortBy="@(ViewBag.CurrentMachineSort == "price_asc" ? "price_desc" : "price_asc")">
                        Price @(ViewBag.CurrentMachineSort == "price_asc" ? "↑" : ViewBag.CurrentMachineSort == "price_desc" ? "↓" : "")
                    </a>
                </th>
                <th style="width: 1%; white-space: nowrap; padding: 0.75rem;">
                    <a 
                       asp-fragment="machines-container"                          
                       asp-action="Home" 
                       asp-controller="@targetController" 
                       asp-route-certificateSortBy="@ViewBag.CurrentCertificateSort"
                       asp-route-supplierSortBy="@ViewBag.CurrentSupplierSort" 
                       asp-route-qualitierSortBy="@(isAdmin ? ViewBag.CurrentQualitierSort : null)" 
                       asp-route-purchaserSortBy="@ViewBag.CurrentPurchaserSort"  
                       asp-route-machineSortBy="@(ViewBag.CurrentMachineSort == "supplier-id_asc" ? "supplier-id_desc" : "supplier-id_asc")">
                        Supplier Id @(ViewBag.CurrentMachineSort == "supplier-id_asc" ? "↑" : ViewBag.CurrentMachineSort == "supplier-id_desc" ? "↓" : "")
                    </a>
                </th>
                <th style="width: 1%; white-space: nowrap; padding: 0.75rem;">
                    <a 
                       asp-fragment="machines-container"                        
                       asp-action="Home" 
                       asp-controller="@targetController" 
                       asp-route-certificateSortBy="@ViewBag.CurrentCertificateSort"
                       asp-route-supplierSortBy="@ViewBag.CurrentSupplierSort" 
                       asp-route-qualitierSortBy="@(isAdmin ? ViewBag.CurrentQualitierSort : null)" 
                       asp-route-purchaserSortBy="@ViewBag.CurrentPurchaserSort" 
                       asp-route-machineSortBy="@(ViewBag.CurrentMachineSort == "added_asc" ? "added_desc" : "added_asc")">
                        Added @(ViewBag.CurrentMachineSort == "added_asc" ? "↑" : ViewBag.CurrentMachineSort == "added_desc" ? "↓" : "")
                    </a>
                </th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Data != null && Model.Data.Any())
            {
                foreach (var machine in Model.Data)
                {
                    string rowUrl = isAdmin 
                        ? $"/admin/suppliers/{machine.AppUserId}/machines/{machine.Id}" 
                        : isQualitier ? $"/qualitier/suppliers/{machine.AppUserId}/machines/{machine.Id}" 
                        : isPurchaser ? $"/purchaser/suppliers/{machine.AppUserId}/machines/{machine.Id}" : "#";

                    <tr onclick="window.location.href = '@rowUrl'">                        
                        <td style="width: 1%; white-space: nowrap; padding: 0.75rem;">@machine.Id</td>
                        <td style="width: 1%; white-space: nowrap; padding: 0.75rem;">@machine.MachineGroup</td>
                        <td style="width: 1%; white-space: nowrap; padding: 0.75rem;">@machine.MachineType</td>
                        <td style="width: 1%; white-space: nowrap; padding: 0.75rem;">@machine.BrandAndModel</td>
                        <td style="width: 1%; white-space: nowrap; padding: 0.75rem;">@machine.ProductionYear</td>
                        <td style="width: 1%; white-space: nowrap; padding: 0.75rem;">@machine.Quantity</td>
                        <td style="width: 1%; white-space: nowrap; padding: 0.75rem;">@machine.AxisCount</td>
                        <td style="width: 1%; white-space: nowrap; padding: 0.75rem;">@machine.CapacitySpecs</td>
                        <td style="width: 1%; white-space: nowrap; padding: 0.75rem;">
                            <a href="@machine.ImageUrl" target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()">View</a>
                        </td>
                        <td style="width: 1%; white-space: nowrap; padding: 0.75rem;" class="element-price-data">$@machine.Price.ToString("N0")</td>
                        <td style="width: 1%; white-space: nowrap; padding: 0.75rem;">@machine.AppUserId</td>
                        <td style="white-space: nowrap; padding: 0.75rem;">@machine.CreatedAt.ToString("dd-MM-yyyy")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="12">
                        <div class="empty-state-message">
                            <p>No suppliers machines are registered in the system yet.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>