@model FetchAllPurchasersGetResponseDTO

@{
    bool isAdmin = User.IsInRole("Admin");
    bool isQualitier = User.IsInRole("Qualitier");

    string targetController = isAdmin ? "admin" : isQualitier ? "qualitier" : "";
}

<div id="purchaser-section" class="list-container">
    <table class="table">
        <thead>
            <tr>
                <th style="padding: 0.75rem;"><a asp-fragment="purchaser-section" asp-action="Home" asp-controller="@targetController" asp-certificateSortBy="@ViewBag.CurrentCertificateSort" asp-machineSortBy="@ViewBag.CurrentMachineSort" asp-route-supplierSortBy="@ViewBag.CurrentSupplierSort" asp-route-qualitierSortBy="@(isAdmin ? ViewBag.CurrentQualitierSort : null)" asp-route-purchaserSortBy="@(ViewBag.CurrentPurchaserSort == "id_asc" ? "id_desc" : "id_asc")">Id @(ViewBag.CurrentPurchaserSort == "id_asc" ? "↑" : ViewBag.CurrentPurchaserSort == "id_desc" ? "↓" : "")</a></th>
                <th style="padding: 0.75rem;"><a asp-fragment="purchaser-section" asp-action="Home" asp-controller="@targetController" asp-certificateSortBy="@ViewBag.CurrentCertificateSort" asp-machineSortBy="@ViewBag.CurrentMachineSort" asp-route-supplierSortBy="@ViewBag.CurrentSupplierSort" asp-route-qualitierSortBy="@(isAdmin ? ViewBag.CurrentQualitierSort : null)" asp-route-purchaserSortBy="@(ViewBag.CurrentPurchaserSort == "name_asc" ? "name_desc" : "name_asc")">Name @(ViewBag.CurrentPurchaserSort == "name_asc" ? "↑" : ViewBag.CurrentPurchaserSort == "name_desc" ? "↓" : "")</a></th>
                <th style="padding: 0.75rem;"><a asp-fragment="purchaser-section" asp-action="Home" asp-controller="@targetController" asp-certificateSortBy="@ViewBag.CurrentCertificateSort" asp-machineSortBy="@ViewBag.CurrentMachineSort" asp-route-supplierSortBy="@ViewBag.CurrentSupplierSort" asp-route-qualitierSortBy="@(isAdmin ? ViewBag.CurrentQualitierSort : null)" asp-route-purchaserSortBy="@(ViewBag.CurrentPurchaserSort == "surname_asc" ? "surname_desc" : "surname_asc")">Surname @(ViewBag.CurrentPurchaserSort == "surname_asc" ? "↑" : ViewBag.CurrentPurchaserSort == "surname_desc" ? "↓" : "")</a></th>
                <th style="padding: 0.75rem;"><a asp-fragment="purchaser-section" asp-action="Home" asp-controller="@targetController" asp-certificateSortBy="@ViewBag.CurrentCertificateSort" asp-machineSortBy="@ViewBag.CurrentMachineSort" asp-route-supplierSortBy="@ViewBag.CurrentSupplierSort" asp-route-qualitierSortBy="@(isAdmin ? ViewBag.CurrentQualitierSort : null)" asp-route-purchaserSortBy="@(ViewBag.CurrentPurchaserSort == "email_asc" ? "email_desc" : "email_asc")">Email @(ViewBag.CurrentPurchaserSort == "email_asc" ? "↑" : ViewBag.CurrentPurchaserSort == "email_desc" ? "↓" : "")</a></th>
                <th style="padding: 0.75rem;"><a asp-fragment="purchaser-section" asp-action="Home" asp-controller="@targetController" asp-certificateSortBy="@ViewBag.CurrentCertificateSort" asp-machineSortBy="@ViewBag.CurrentMachineSort" asp-route-supplierSortBy="@ViewBag.CurrentSupplierSort" asp-route-qualitierSortBy="@(isAdmin ? ViewBag.CurrentQualitierSort : null)" asp-route-purchaserSortBy="@(ViewBag.CurrentPurchaserSort == "purchases_asc" ? "purchases_desc" : "purchases_asc")">Puchases @(ViewBag.CurrentPurchaserSort == "purchases_asc" ? "↑" : ViewBag.CurrentPurchaserSort == "purchases_desc" ? "↓" : "")</a></th>
                <th style="padding: 0.75rem;"><a asp-fragment="purchaser-section" asp-action="Home" asp-controller="@targetController" asp-certificateSortBy="@ViewBag.CurrentCertificateSort" asp-machineSortBy="@ViewBag.CurrentMachineSort" asp-route-supplierSortBy="@ViewBag.CurrentSupplierSort" asp-route-qualitierSortBy="@(isAdmin ? ViewBag.CurrentQualitierSort : null)" asp-route-purchaserSortBy="@(ViewBag.CurrentPurchaserSort == "added_asc" ? "added_desc" : "added_asc")">Created At @(ViewBag.CurrentPurchaserSort == "added_asc" ? "↑" : ViewBag.CurrentPurchaserSort == "added_desc" ? "↓" : "")</a></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Data != null && Model.Data.Any())
            {
                foreach (var purchaser in Model.Data)
                {
                    <tr onclick="window.location.href = '/@targetController/purchasers/@purchaser.Id'">
                        <td style="padding: 0.75rem;">@purchaser.Id</td>
                        <td style="padding: 0.75rem;">@purchaser.Name</td>
                        <td style="text-transform: uppercase; padding: 0.75rem;">@purchaser.Surname</td>
                        <td style="padding: 0.75rem;">@purchaser.Email</td>
                        <td style="padding: 0.75rem;">
                            <a asp-controller="@targetController" asp-action="PurchaserPurchases" asp-route-purchaserId="@purchaser.Id" onclick="event.stopPropagation()" class="resource-link">
                                Purchases 
                                @if (purchaser.Purchases.Count > 0)
                                {
                                    <i class="fa-solid fa-circle-check" style="color: #2ed47a; margin: 0 0 3px 0;" title="Completed"></i>
                                }
                                else
                                {
                                    <i class="fa-solid fa-circle-minus" style="color: rgba(255, 255, 255, 0.2); margin: 0 0 3px 0;" title="Missing"></i>
                                }
                            </a>
                        </td>
                        <td style="padding: 0.75rem;">@purchaser.CreatedAt.ToString("dd-MM-yyyy")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6">
                        <div class="empty-state-message">
                            <p>No purchasers are registered in the system yet.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>